            "hsync_back_porch": 40,
            "hsync_pulse_width": 2,
            "hsync_front_porch": 40,
            "vsync_back_porch": 8,
            "vsync_pulse_width": 2,
            "vsync_front_porch": 220
          }
        }
      }
    },
    "touch": {
      "kind": "touch",
      "part": "st7123_touch",
      "bus": "touch_i2c",
      "i2c_addr": "0x55",
      "spec": {
        "x_max": 719,
        "y_max": 1279,
        "rotation_offset": 0
      }
    },
    "backlight": {
      "kind": "backlight",
      "bus": "internal_i2c",
      "i2c_addr": "0x6E",
      "note": "LCD backlight enable is PM1 GPIO3 (PWM channel 0, 5 kHz, 12-bit); the PM1 is addressed on the internal bus."
    },
    "pmic": {
      "kind": "pmic",
      "part": "m5pm1",
      "bus": "internal_i2c",
      "note": "PM1 also drives the RGB LED, Grove15 5V, USB-A 5V and the CHIP_EN gate."
    },
    "ioe": {
      "kind": "io_expander",
      "part": "m5ioe1",
      "bus": "internal_i2c",
      "note": "IOE1 switches the 5V rail of Grove0-11, 13 and 14."
    },
    "ina226": {
      "kind": "sensor",
      "bus": "internal_i2c",
      "i2c_addr": "0x40",
      "note": "INA226 with 5 mOhm shunt on the Grove 5V rail (A0/A1 grounded)."
    },
    "rgb_led": {
      "kind": "led",
      "note": "RGB LED behind the PM1: red on LED_EN (active high), green on PM1 GPIO4, blue on PM1 GPIO0 (both active low)."
    },
    "psram": {
      "kind": "psram",
      "part": "psram"
    }
