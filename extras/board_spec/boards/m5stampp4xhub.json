    "grove11": {
      "type": "hy2_4p",
      "standard": "port_io",
      "note": "5V rail switched by M5IOE1 IOEG2."
    },
    "grove12": {
      "type": "hy2_4p",
      "standard": "port_uart",
      "note": "UART0 console on signal A (TX, GPIO37) and signal B (RX, GPIO38). The 5V rail is the PM1 CHG_EN output and has no separate software enable."
    },
    "grove13": {
      "type": "hy2_4p",
      "standard": "port_i2c",
      "note": "External I2C on the system bus (SCL GPIO1, SDA GPIO0, 2.2K pull-ups). Signal A is SDA and signal B is SCL; the 5V rail is switched by M5IOE1 IOEG3 and also feeds the I2C level shifter."
    },
    "grove14": {
      "type": "hy2_4p",
      "standard": "port_io",
      "note": "USB1 D+ / D-; do not use as GPIO while USB1 is active. 5V rail switched by M5IOE1 IOEG8."
    },
    "grove15": {
      "type": "hy2_4p",
      "standard": "port_io",
      "note": "Shared with LCD_RST/TP_RST (signal A, GPIO3) and TP_INT (signal B, GPIO2); using this port can reset the panel or lose touch. 5V rail switched by PM1 GPIO2."
    }
