      "kind": "led_strip",
      "part": "sk6812",
      "verified": {
        "part": "datasheet"
      }
    },
    "buzzer": {
      "kind": "speaker"
    },
    "ioe": {
      "kind": "io_expander",
      "part": "pi4io",
      "bus": "internal_i2c",
      "i2c_addr": "0x43",
