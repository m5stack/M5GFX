        "p2": {
          "roles": [
            "dev:btn_a.in"
          ]
        },
        "p1": {
          "roles": [
            "dev:btn_b.in"
          ]
        },
        "p0": {
          "roles": [
            "dev:btn_c.in"
          ]
        }
      }
    },
    "btn_a": {
      "kind": "button",
      "part": "button",
      "spec": {
        "active_low": true,
        "pull": "internal_up"
      }
    },
    "btn_b": {
      "kind": "button",
      "part": "button",
      "spec": {
        "active_low": true,
        "pull": "internal_up"
      }
    },
    "btn_c": {
      "kind": "button",
      "part": "button",
      "spec": {
        "active_low": true,
        "pull": "internal_up"
      }
    }
  },
  "connectors": {
    "port_a": {
      "type": "hy2_4p",
      "standard": "port_i2c"
    },
    "ext_bus": {
      "type": "logical_terminals_16",
      "positions": {
        "1": "pwr:vin",
        "2": "pwr:gnd",
        "3": "pwr:gnd",
        "4": "pwr:gnd",
        "5": "pwr:gnd",
        "6": "pwr:5vout"
      },
      "note": "Exposed StamPLC-Bus J9; terminal numbering follows the official StamPLC-Bus table and IO schematic. SCL/SDA, PHY_RST/INT and SPI signals share internal peripherals. Isolated input, relay, CAN and RS485 terminals are not direct GPIO connections and are outside this catalog entry.",
      "verified": {
        "positions": "datasheet"
      }
    },
    "grove_c": {
      "type": "hy2_4p",
      "standard": "port_uart",
      "note": "Product marking is PORT.C: white GPIO4, yellow GPIO5, red 5V, black GND. M5Unified does not assign StamPLC Port C in its package pin table, so this is cataloged as the physical grove_c connector rather than the port_c contract name."
    }
  }
}
