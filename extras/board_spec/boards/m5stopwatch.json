{
  "schema_version": 1,
  "id": "m5stopwatch",
  "name": "M5StopWatch",
  "official_name": "M5Stack StopWatch",
  "official_name_verified": true,
  "aliases": [
    "stopwatch",
    "stop watch"
  ],
  "legacy_board_id": 30,
  "chip": "esp32s3",
  "spec": {
    "display": {
      "resolution": [
        468,
        468
      ],
      "touch": true
    },
    "storage": {
      "psram_mb": 8,
      "psram_mode": "opi",
      "flash_mb": 16
    },
    "links": {
      "schematic": "https://m5stack-doc.oss-cn-shenzhen.aliyuncs.com/1242/C152-SCH_Stopwatch_PRJ_Main_VA_20251201_2026_04_24_17_46_22.pdf",
      "product": "https://docs.m5stack.com/en/core/StopWatch"
    }
  },
  "pins": {
    "0": {
      "roles": [
        "conn:rear_mux.5"
      ],
      "note": "BOOT; connected to M5PM1 BOOT_OUT_OD."
    },
    "1": {
      "roles": [
        "dev:btn_b.in"
      ]
    },
    "2": {
      "roles": [
        "dev:btn_a.in"
      ]
    },
    "3": {
      "roles": [
        "conn:rear_gpio.1"
      ],
      "note": "J5 EXT_GPIO3."
    },
    "4": {
      "roles": [
        "conn:rear_gpio.2"
      ],
      "note": "J5 EXT_GPIO4."
    },
    "5": {
      "roles": [
        "conn:rear_gpio.3"
      ],
      "note": "J5 EXT_GPIO5."
    },
    "6": {
      "roles": [
        "conn:rear_gpio.4"
      ],
      "note": "J5 EXT_GPIO6."
    },
    "7": {
      "roles": [
        "conn:rear_gpio.5"
      ],
      "note": "J5 EXT_GPIO7."
    },
    "8": {
      "roles": [
        "conn:rear_gpio.6"
      ],
      "note": "J5 EXT_GPIO8."
    },
    "9": {
      "roles": [
        "conn:rear_mux.4"
      ],
      "note": "J6 EXT_GPIO9."
    },
    "10": {
      "roles": [
        "bus:port_a_i2c.sda",
        "conn:port_a.2"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "11": {
      "roles": [
        "bus:port_a_i2c.scl",
        "conn:port_a.1"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "12": {
      "roles": [
        "dev:pmic.int"
      ],
      "note": "G12_PY_IRQ from M5PM1 G1_IRQout."
    },
    "13": {
      "roles": [
        "dev:touch.int"
      ]
    },
    "14": {
      "roles": [],
      "note": "R34 is not populated, so GPIO14 is unconnected by default. Fitting R34 connects it to PYB_SPK_EN; the stock amplifier enable is controlled by M5IOE1 PYG10."
    },
    "26": {
      "roles": [
        "dev:psram.cs"
      ]
    },
    "27": {
      "roles": [
        "dev:psram.d3"
      ]
    },
    "28": {
      "roles": [
        "dev:psram.d2"
      ]
    },
    "30": {
      "roles": [
        "dev:psram.clk"
      ]
    },
    "31": {
      "roles": [
        "dev:psram.d1"
      ]
    },
    "32": {
      "roles": [
        "dev:psram.d0"
      ]
    },
    "33": {
      "roles": [
        "dev:psram.d4"
      ]
    },
    "34": {
      "roles": [
        "dev:psram.d5"
      ]
    },
    "35": {
      "roles": [
        "dev:psram.d6"
      ]
    },
    "36": {
      "roles": [
        "dev:psram.d7"
      ]
    },
    "37": {
      "roles": [
        "dev:psram.dqs"
      ]
    },
    "38": {
      "roles": [],
      "note": "OLED TE input"
    },
    "39": {
      "roles": [
        "dev:lcd.cs"
      ]
    },
    "40": {
      "roles": [
        "bus:main_spi.sclk"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "41": {
      "roles": [
        "bus:main_spi.io0"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "42": {
      "roles": [
        "bus:main_spi.io1"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "45": {
      "roles": [
        "bus:main_spi.io3"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "46": {
      "roles": [
        "bus:main_spi.io2"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "47": {
      "roles": [
        "bus:internal_i2c.sda",
        "bus:touch_i2c.sda"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "48": {
      "roles": [
        "bus:internal_i2c.scl",
        "bus:touch_i2c.scl"
      ],
      "verified": {
        "roles": "generated"
      }
    }
  },
  "buses": {
    "main_spi": {
      "kind": "spi",
      "signals": [
        "sclk",
        "io0",
        "io1",
        "io2",
        "io3"
      ],
      "preferred_host": "SPI2_HOST",
      "fixed": false,
      "freq": 80000000,
      "freq_read": 1000000,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated",
        "freq": "generated",
        "freq_read": "generated"
      }
    },
    "internal_i2c": {
      "kind": "i2c",
      "signals": [
        "sda",
        "scl"
      ],
      "preferred_host": 1,
      "freq": 100000,
      "fixed": false,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated",
        "freq": "generated"
      }
    },
    "touch_i2c": {
      "kind": "i2c",
      "signals": [
        "sda",
        "scl"
      ],
      "preferred_host": 1,
      "freq": 400000,
      "fixed": false,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated",
        "freq": "generated"
      }
    },
    "port_a_i2c": {
      "kind": "i2c",
      "signals": [
        "sda",
        "scl"
      ],
      "preferred_host": 0,
      "fixed": false,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated"
      }
    }
  },
  "devices": {
    "lcd": {
      "kind": "display",
      "part": "co5300",
      "bus": "main_spi",
      "spec": {
        "width": 468,
        "height": 468,
        "offset_x": 6,
        "offset_y": 0,
        "rotation_offset": 0,
        "invert": false,
        "readable": false,
        "three_wire": true
      }
    },
    "touch": {
      "kind": "touch",
      "part": "cst816s",
      "bus": "touch_i2c",
      "i2c_addr": "0x15",
      "spec": {
        "x_min": 0,
        "x_max": 233,
        "y_min": 0,
        "y_max": 233,
        "rotation_offset": 0
      }
    },
    "pmic": {
      "kind": "pmic",
      "part": "m5pm1",
      "bus": "internal_i2c",
      "pins": {
        "pwrkey": {
          "roles": [
            "dev:btn_pwr.in"
          ]
        }
      }
    },
    "ioe": {
      "kind": "io_expander",
      "part": "m5ioe1",
      "bus": "internal_i2c"
    },
    "rtc": {
      "kind": "rtc",
      "bus": "internal_i2c",
      "i2c_addr": "0x32"
    },
    "imu": {
      "kind": "imu",
      "bus": "internal_i2c",
      "i2c_addr": "0x68"
    },
    "nfc": {
      "kind": "sensor",
      "bus": "internal_i2c",
      "i2c_addr": "0x50"
    },
    "btn_a": {
      "kind": "button",
      "part": "button",
      "spec": {
        "active_low": true,
        "pull": "external_up"
      }
    },
    "btn_b": {
      "kind": "button",
      "part": "button",
      "spec": {
        "active_low": true,
        "pull": "external_up"
      }
    },
    "btn_pwr": {
      "kind": "button",
      "part": "button",
      "spec": {
        "active_low": true,
        "pull": "pmic"
      }
    },
    "psram": {
      "kind": "psram",
      "part": "psram"
    },
    "rear_mux": {
      "kind": "transceiver",
      "part": "ch442e",
      "pins": {
        "io1": {
          "roles": [
            "conn:rear_mux.2"
          ],
          "note": "MUX_IO_1 / DB (U26 pin 4)."
        },
        "io2": {
          "roles": [
            "conn:rear_mux.3"
          ],
          "note": "MUX_IO_2 / DC (U26 pin 6)."
        }
      },
      "note": "U26 CH442E routes MUX_IO_1/2 through a switch, not a direct GPIO connection. M5IOE1 at 0x4F controls IN via PYG1 (PYB_MUX_CTR): low selects G43 UART0 TX / G44 UART0 RX (default); high selects G20 USB_P / G19 USB_N."
    }
  },
  "connectors": {
    "port_a": {
      "type": "hy2_4p",
      "standard": "port_i2c"
    },
    "rear_gpio": {
      "type": "socket_1x7_254",
      "positions": {
        "7": "pwr:bat"
      },
      "note": "Rear right J5: pins 1-6 are G3-G8; pin 7 is BAT on v1.0.1. On v1.0, pin 7 is an external 5V input, including batches incorrectly labeled BAT. Never connect a battery to the v1.0 pin. The linked schematic shows the older Int_5V connection.",
      "group": "rear"
    },
    "rear_mux": {
      "type": "socket_1x6_254",
      "positions": {
        "1": "pwr:3v3",
        "2": "pin:rear_mux.io1",
        "3": "pin:rear_mux.io2",
        "6": "pwr:gnd"
      },
      "note": "Rear left J6: pin 1 is the switched 3V3_L2 output through R59 (0 ohm); do not exceed 200 mA. Pins 2/3 are CH442E MUX_IO_1/2: G43/G44 UART0 by default, G20/G19 USB when M5IOE1 PYG1 is high. Pin 4 is G9, pin 5 is G0 BOOT, pin 6 is GND.",
      "group": "rear"
    }
  }
}
