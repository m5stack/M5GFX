      }
    },
    "41": {
      "roles": [
        "bus:main_spi.io0"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "42": {
      "roles": [
        "bus:main_spi.io1"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "45": {
      "roles": [
        "bus:main_spi.io3"
      ],
      "verified": {
        "roles": "generated"
      }
