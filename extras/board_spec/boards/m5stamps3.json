        "positions": "datasheet"
      }
    },
    "lcd_fpc8": {
      "type": "logical_terminals_8",
      "positions": {
        "1": "pwr:lcd_bl",
        "2": "pwr:gnd",
        "7": "pwr:3v3"
      },
      "note": "Rear J3 8-pin 0.5mm LCD footprint, marked NC in the schematic. Pin 1 BL is the SGM2578 regulated output switched by GPIO38, not a direct GPIO38 connection. Numbers follow J3; the 8-pin and 12-pin footprints are assembly alternatives.",
