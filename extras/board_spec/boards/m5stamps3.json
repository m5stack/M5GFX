    "stamp_pads": {
      "type": "logical_terminals_28",
      "positions": {
        "11": "pwr:gnd",
        "13": "pwr:5v",
        "18": "pwr:gnd",
        "22": "chip:en",
        "28": "pwr:3v3"
      },
      "note": "Numbers follow M1 in the official v0.2 schematic. Module SMT/DIP pads support different pitch variants; this is an electrical terminal ordering.",
      "verified": {
        "positions": "datasheet"
      }
    },
    "lcd_fpc12": {
      "type": "logical_terminals_12",
      "positions": {
        "1": "pwr:5v",
        "5": "pwr:lcd_bl",
        "6": "pwr:gnd",
        "11": "pwr:3v3"
      },
      "note": "Rear J1 12-pin 0.5mm LCD/extension footprint, marked NC in the schematic. Pin 5 BL is the SGM2578 regulated output switched by GPIO38, not a direct GPIO38 connection. Numbers follow J1.",
