        "roles": "generated"
      }
    },
    "12": {
      "roles": [
        "bus:internal_i2c.sda"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "13": {
      "roles": [
        "bus:port_a_i2c.scl",
        "conn:port_a.1"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "14": {
      "roles": [
        "bus:internal_i2c.scl"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "16": {
      "roles": [
        "dev:psram.cs"
      ]
    },
    "17": {
      "roles": [
        "dev:psram.clk"
      ]
    },
    "33": {
      "roles": [
        "dev:power_hold.enable"
