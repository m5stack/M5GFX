{
  "schema_version": 1,
  "id": "m5stickcplus2",
  "name": "M5StickCPlus2",
  "official_name": "M5Stack StickC-Plus2",
  "official_name_verified": true,
  "aliases": [
    "stickc plus2",
    "m5stickc plus2",
    "stickcplus2"
  ],
  "legacy_board_id": 5,
  "chip": "esp32_d0wdq6",
  "spec": {
    "display": {
      "resolution": [
        135,
        240
      ],
      "touch": false
    },
    "storage": {
      "psram_mb": 2,
      "psram_mode": "quad"
    }
  },
  "pins": {
    "0": {
      "roles": [
        "dev:usb_serial.boot"
      ]
    },
    "1": {
      "roles": [
        "bus:console_uart.tx"
      ]
    },
    "3": {
      "roles": [
        "bus:console_uart.rx"
      ]
    },
    "4": {
      "roles": [
        "dev:power_hold.enable"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "5": {
      "roles": [
        "dev:lcd.cs"
      ]
    },
    "9": {
      "roles": [
        "dev:psram.cs"
      ]
    },
    "10": {
      "roles": [
        "dev:psram.clk"
      ]
    },
    "12": {
      "roles": [
        "dev:lcd.rst"
      ]
    },
    "13": {
      "roles": [
        "bus:main_spi.sclk"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "14": {
      "roles": [
        "dev:lcd.dc"
      ]
    },
    "15": {
      "roles": [
        "bus:main_spi.mosi"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "19": {
      "roles": [
        "dev:ir_led.on",
        "dev:red_led.on"
      ],
      "pull": "down",
      "note": "IR transmitter and red LED driven through Q5 base",
      "verified": {
        "pull": "measured"
      },
      "measured_by": {
        "pull": "Internal-pull GPIO survey on M5StickCPlus2"
      }
    },
    "21": {
      "roles": [
        "bus:internal_i2c.sda"
      ],
      "pull": "up",
      "verified": {
        "roles": "generated",
        "pull": "measured"
      },
      "measured_by": {
        "pull": "Internal-pull GPIO survey on M5StickCPlus2"
      }
    },
    "22": {
      "roles": [
        "bus:internal_i2c.scl"
      ],
      "pull": "up",
      "verified": {
        "roles": "generated",
        "pull": "measured"
      },
      "measured_by": {
        "pull": "Internal-pull GPIO survey on M5StickCPlus2"
      }
    },
    "27": {
      "roles": [
        "dev:backlight.pwm"
      ]
    },
    "32": {
      "roles": [
        "bus:port_a_i2c.sda",
        "conn:port_a.2"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "33": {
      "roles": [
        "bus:port_a_i2c.scl",
        "conn:port_a.1"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "35": {
      "roles": [
        "dev:btn_pwr.in"
      ]
    },
    "37": {
      "roles": [
        "dev:btn_a.in"
      ]
    },
    "39": {
      "roles": [
        "dev:btn_b.in"
      ]
    }
  },
  "buses": {
    "console_uart": {
      "kind": "uart",
      "signals": [
        "tx",
        "rx"
      ],
      "preferred_host": 0,
      "fixed": true
    },
    "main_spi": {
      "kind": "spi",
      "signals": [
        "sclk",
        "mosi"
      ],
      "preferred_host": "SPI2_HOST",
      "fixed": false,
      "freq": 40000000,
      "freq_read": 15000000,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated",
        "freq": "generated",
        "freq_read": "generated"
      }
    },
    "internal_i2c": {
      "kind": "i2c",
      "signals": [
        "sda",
        "scl"
      ],
      "preferred_host": 1,
      "fixed": false,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated"
      }
    },
    "port_a_i2c": {
      "kind": "i2c",
      "signals": [
        "sda",
        "scl"
      ],
      "preferred_host": 0,
      "fixed": false,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated"
      }
    }
  },
  "devices": {
    "usb_serial": {
      "kind": "usb_uart",
      "part": "ch9102",
      "bus": "console_uart",
      "spec": {
        "auto_reset": true
      }
    },
    "lcd": {
      "kind": "display",
      "part": "st7789v2",
      "bus": "main_spi",
      "spec": {
        "width": 135,
        "height": 240,
        "offset_x": 52,
        "offset_y": 40,
        "invert": true,
        "three_wire": true
      }
    },
    "backlight": {
      "kind": "backlight",
      "spec": {
        "freq": 256,
        "channel": 7,
        "invert": false,
        "offset": 40
      },
      "verified": {
        "spec": "generated"
      }
    },
    "power_hold": {
      "kind": "power_hold"
    },
    "ir_led": {
      "kind": "led"
    },
    "red_led": {
      "kind": "led"
    },
    "btn_a": {
      "kind": "button",
      "part": "button",
      "spec": {
        "active_low": true,
        "pull": "external_up"
      }
    },
    "btn_b": {
      "kind": "button",
      "part": "button",
      "spec": {
        "active_low": true,
        "pull": "external_up"
      }
    },
    "btn_pwr": {
      "kind": "button",
      "part": "button",
      "spec": {
        "active_low": true,
        "pull": "external_up"
      }
    },
    "psram": {
      "kind": "psram",
      "part": "psram"
    }
  },
  "connectors": {
    "port_a": {
      "type": "hy2_4p",
      "standard": "port_i2c"
    }
  },
  "chip_package": "pico_v3_02"
}
