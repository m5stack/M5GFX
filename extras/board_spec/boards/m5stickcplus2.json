    "hat": {
      "type": "socket_1x8_254",
      "positions": {
        "1": "pwr:gnd",
        "2": "pwr:5vout",
        "6": "pwr:bat",
        "7": "pwr:3v3",
        "8": "pwr:5vin"
      },
      "verified": {
        "type": "datasheet",
        "positions": "datasheet"
      },
      "note": "HAT socket: positions 1-8 run from GND to 5V input, left to right in the rear-label view. GPIO0 is shared with the microphone clock. 5V output and 5V input are separate rails. P1 pin 4 joins GPIO36 and GPIO25 in the official v0.5 schematic; the rear label reads G36/G25. The Specifications External Pins field says G25/G26, which differs from the rear-label G36/G25 notation. This catalog follows the rear label and documented G36/G25 shared terminal without treating either notation as a confirmed typo. When using GPIO36 or GPIO25, leave the other as an input with both internal pulls disabled, as instructed by the official StickC-Plus documentation.",
      "multi_gpio": [
        "4"
      ]
    }
