        "positions": "datasheet"
      },
      "group": "fpc"
    },
    "fpc_spi": {
      "type": "logical_terminals_12",
      "positions": {
        "2": "pwr:gnd",
        "6": "pwr:gnd",
        "7": "pin:pmic.gpio4",
        "10": "pin:pmic.gpio1",
        "11": "pwr:3v3_l2",
        "12": "pwr:3v3_l2"
      },
      "note": "FPC-SPI 0.5mm 12P, numbered as the official PinMap (pin 7 RST, 8 BUSY, 9 IRQ, 10 SW). SCK / MOSI / MISO are shared with the microSD slot.",
