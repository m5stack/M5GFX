{
  "schema_version": 1,
  "id": "m5stickc",
  "name": "M5StickC",
  "legacy_board_id": 3,
  "chip": "esp32_d0wdq6",
  "spec": {
    "display": {
      "resolution": [
        80,
        160
      ],
      "touch": false
    }
  },
  "pins": {
    "5": {
      "roles": [
        "dev:lcd.cs"
      ]
    },
    "13": {
      "roles": [
        "bus:main_spi.sclk"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "14": {
      "roles": [
        "bus:main_spi.miso"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "15": {
      "roles": [
        "bus:main_spi.mosi"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "18": {
      "roles": [
        "dev:lcd.rst"
      ]
    },
    "21": {
      "roles": [
        "bus:internal_i2c.sda"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "22": {
      "roles": [
        "bus:internal_i2c.scl"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "23": {
      "roles": [
        "dev:lcd.dc"
      ]
    },
    "32": {
      "roles": [
        "bus:port_a_i2c.sda",
        "conn:port_a.2"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "33": {
      "roles": [
        "bus:port_a_i2c.scl",
        "conn:port_a.1"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "37": {
      "roles": [],
      "note": "BtnA, active low"
    },
    "39": {
      "roles": [],
      "note": "BtnB, active low"
    }
  },
  "buses": {
    "main_spi": {
      "kind": "spi",
      "signals": [
        "sclk",
        "mosi",
        "miso"
      ],
      "preferred_host": "SPI2_HOST",
      "fixed": false,
      "freq": 27000000,
      "freq_read": 14000000,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated",
        "freq": "generated",
        "freq_read": "generated"
      }
    },
    "internal_i2c": {
      "kind": "i2c",
      "signals": [
        "sda",
        "scl"
      ],
      "preferred_host": 1,
      "fixed": false,
      "freq": 400000,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated",
        "freq": "generated"
      }
    },
    "port_a_i2c": {
      "kind": "i2c",
      "signals": [
        "sda",
        "scl"
      ],
      "preferred_host": 0,
      "fixed": false,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated"
      }
    }
  },
  "devices": {
    "lcd": {
      "kind": "display",
      "part": "st7735s",
      "bus": "main_spi",
      "spec": {
        "width": 80,
        "height": 160,
        "offset_x": 26,
        "offset_y": 1,
        "rotation_offset": 2,
        "invert": true,
        "three_wire": true,
        "panel_type": "st7735s"
      },
      "signals": {
        "cs": "gpio:5",
        "rst": "gpio:18",
        "dc": "gpio:23"
      },
      "verified": {
        "signals": "generated"
      }
    },
    "backlight": {
      "kind": "backlight",
      "bus": "internal_i2c",
      "i2c_addr": "0x34"
    },
    "pmic": {
      "kind": "pmic",
      "part": "axp192",
      "bus": "internal_i2c",
      "i2c_addr": "0x34"
    }
  },
  "connectors": {
    "port_a": {
      "type": "hy2_4p",
      "standard": "port_i2c",
      "positions": {
        "1": "gpio:33",
        "2": "gpio:32",
        "3": "pwr:5v",
        "4": "pwr:gnd"
      }
    }
  }
}
