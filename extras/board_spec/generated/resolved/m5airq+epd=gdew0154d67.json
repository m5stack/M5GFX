{
  "schema_version": 1,
  "id": "m5airq",
  "name": "M5AirQ",
  "official_name": "M5Stack Air Quality",
  "official_name_verified": true,
  "aliases": [
    "airq",
    "air quality",
    "air quality kit"
  ],
  "legacy_board_id": 15,
  "chip": "esp32s3",
  "spec": {
    "display": {
      "resolution": [
        200,
        200
      ],
      "touch": false
    },
    "storage": {
      "psram_mb": 0,
      "flash_mb": 8
    }
  },
  "pins": {
    "0": {
      "roles": [
        "dev:btn_a.in"
      ]
    },
    "1": {
      "roles": [
        "dev:epd.busy"
      ]
    },
    "2": {
      "roles": [
        "dev:epd.rst"
      ]
    },
    "3": {
      "roles": [
        "dev:epd.dc"
      ]
    },
    "4": {
      "roles": [
        "dev:epd.cs"
      ]
    },
    "5": {
      "roles": [
        "bus:main_spi.sclk"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "6": {
      "roles": [
        "bus:main_spi.mosi"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "8": {
      "roles": [
        "dev:btn_b.in"
      ]
    },
    "11": {
      "roles": [
        "bus:internal_i2c.sda"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "12": {
      "roles": [
        "bus:internal_i2c.scl"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "13": {
      "roles": [
        "bus:port_a_i2c.sda",
        "conn:port_a.2"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "15": {
      "roles": [
        "bus:port_a_i2c.scl",
        "conn:port_a.1"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "21": {
      "roles": [
        "dev:led.data"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "46": {
      "roles": [
        "dev:power_hold.enable"
      ],
      "verified": {
        "roles": "generated"
      }
    }
  },
  "buses": {
    "main_spi": {
      "kind": "spi",
      "signals": [
        "sclk",
        "mosi"
      ],
      "preferred_host": "SPI2_HOST",
      "fixed": false,
      "freq": 40000000,
      "freq_read": 16000000,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated",
        "freq": "generated",
        "freq_read": "generated"
      }
    },
    "internal_i2c": {
      "kind": "i2c",
      "signals": [
        "sda",
        "scl"
      ],
      "preferred_host": 1,
      "fixed": false,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated"
      }
    },
    "port_a_i2c": {
      "kind": "i2c",
      "signals": [
        "sda",
        "scl"
      ],
      "preferred_host": 0,
      "fixed": false,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated"
      }
    }
  },
  "devices": {
    "epd": {
      "kind": "display",
      "bus": "main_spi",
      "part": "gdew0154d67",
      "spec": {
        "width": 200,
        "height": 200
      },
      "signals": {
        "busy": "gpio:1",
        "rst": "gpio:2",
        "dc": "gpio:3",
        "cs": "gpio:4"
      },
      "verified": {
        "signals": "generated"
      }
    },
    "power_hold": {
      "kind": "power_hold",
      "signals": {
        "enable": "gpio:46"
      },
      "verified": {
        "signals": "generated"
      }
    },
    "led": {
      "kind": "led_strip",
      "part": "sk6812",
      "verified": {
        "part": "datasheet",
        "signals": "generated"
      },
      "signals": {
        "data": "gpio:21"
      }
    },
    "btn_a": {
      "kind": "button",
      "part": "button",
      "spec": {
        "active_low": true,
        "pull": "external_up"
      },
      "signals": {
        "in": "gpio:0"
      },
      "verified": {
        "signals": "generated"
      }
    },
    "btn_b": {
      "kind": "button",
      "part": "button",
      "spec": {
        "active_low": true,
        "pull": "external_up"
      },
      "signals": {
        "in": "gpio:8"
      },
      "verified": {
        "signals": "generated"
      }
    }
  },
  "connectors": {
    "port_a": {
      "type": "hy2_4p",
      "standard": "port_i2c",
      "positions": {
        "1": "gpio:15",
        "2": "gpio:13",
        "3": "pwr:5v",
        "4": "pwr:gnd"
      }
    }
  }
}
