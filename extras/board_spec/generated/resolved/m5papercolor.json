{
  "schema_version": 1,
  "id": "m5papercolor",
  "name": "M5PaperColor",
  "legacy_board_id": 28,
  "chip": "esp32s3",
  "spec": {
    "display": {
      "resolution": [
        400,
        600
      ],
      "touch": false
    },
    "storage": {
      "psram_mb": 8,
      "psram_mode": "opi",
      "sd": true
    }
  },
  "pins": {
    "1": {
      "roles": [],
      "note": "BtnC, active low"
    },
    "2": {
      "roles": [
        "bus:internal_i2c.scl"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "3": {
      "roles": [
        "bus:internal_i2c.sda"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "4": {
      "roles": [
        "bus:port_a_i2c.sda",
        "conn:port_a.2"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "5": {
      "roles": [
        "bus:port_a_i2c.scl",
        "conn:port_a.1"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "9": {
      "roles": [],
      "note": "BtnB, active low"
    },
    "10": {
      "roles": [],
      "note": "BtnA, active low"
    },
    "11": {
      "roles": [
        "dev:epd.busy"
      ]
    },
    "12": {
      "roles": [
        "dev:epd.rst"
      ]
    },
    "13": {
      "roles": [
        "bus:main_spi.mosi",
        "dev:sd.cmd"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "14": {
      "roles": [
        "bus:main_spi.miso",
        "dev:sd.d0"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "15": {
      "roles": [
        "bus:main_spi.sclk",
        "dev:sd.clk"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "21": {
      "roles": [
        "dev:rgb_led.data"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "43": {
      "roles": [
        "dev:epd.dc"
      ]
    },
    "44": {
      "roles": [
        "dev:epd.cs"
      ]
    },
    "47": {
      "roles": [
        "dev:sd.d3"
      ],
      "verified": {
        "roles": "generated"
      }
    }
  },
  "buses": {
    "main_spi": {
      "kind": "spi",
      "signals": [
        "sclk",
        "mosi",
        "miso"
      ],
      "preferred_host": "SPI2_HOST",
      "fixed": false,
      "freq": 4000000,
      "freq_read": 1000000,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated",
        "freq": "generated",
        "freq_read": "generated"
      }
    },
    "internal_i2c": {
      "kind": "i2c",
      "signals": [
        "sda",
        "scl"
      ],
      "preferred_host": 1,
      "freq": 100000,
      "fixed": false,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated",
        "freq": "generated"
      }
    },
    "port_a_i2c": {
      "kind": "i2c",
      "signals": [
        "sda",
        "scl"
      ],
      "preferred_host": 0,
      "fixed": false,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated"
      }
    }
  },
  "devices": {
    "epd": {
      "kind": "display",
      "part": "ed2208",
      "bus": "main_spi",
      "spec": {
        "width": 400,
        "height": 600,
        "offset_x": 0,
        "offset_y": 0,
        "rotation_offset": 0,
        "invert": false,
        "readable": false,
        "three_wire": true
      },
      "signals": {
        "busy": "gpio:11",
        "rst": "gpio:12",
        "dc": "gpio:43",
        "cs": "gpio:44"
      },
      "verified": {
        "signals": "generated"
      }
    },
    "sd": {
      "kind": "sd",
      "part": "sd_slot",
      "bus": "main_spi",
      "verified": {
        "bus": "generated",
        "signals": "generated",
        "derived": "generated"
      },
      "signals": {
        "cmd": "gpio:13",
        "d0": "gpio:14",
        "clk": "gpio:15",
        "d3": "gpio:47"
      },
      "derived": {
        "modes": [
          "spi",
          "sdio1"
        ],
        "bus": "main_spi",
        "cs": "gpio:47"
      }
    },
    "pmic": {
      "kind": "pmic",
      "part": "m5pm1",
      "bus": "internal_i2c"
    },
    "rtc": {
      "kind": "rtc",
      "part": "rx8130",
      "bus": "internal_i2c"
    },
    "env": {
      "kind": "sensor",
      "part": "sht40",
      "bus": "internal_i2c"
    },
    "rgb_led": {
      "kind": "led_strip",
      "part": "sk6812",
      "spec": {
        "count": 2
      },
      "signals": {
        "data": "gpio:21"
      },
      "verified": {
        "signals": "generated"
      }
    }
  },
  "connectors": {
    "port_a": {
      "type": "hy2_4p",
      "standard": "port_i2c",
      "positions": {
        "1": "gpio:5",
        "2": "gpio:4",
        "3": "pwr:5v",
        "4": "pwr:gnd"
      }
    }
  }
}
