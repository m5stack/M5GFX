      "positions": {
        "1": "gpio:16",
        "2": "gpio:15",
        "3": "pwr:5v",
        "4": "pwr:gnd"
      }
    },
    "port_c": {
      "type": "hy2_4p",
      "standard": "port_uart",
      "positions": {
        "1": "gpio:1",
        "2": "gpio:2",
        "3": "pwr:5v",
        "4": "pwr:gnd"
      }
    }
