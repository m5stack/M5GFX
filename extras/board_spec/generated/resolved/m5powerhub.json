{
  "schema_version": 1,
  "id": "m5powerhub",
  "name": "M5PowerHub",
  "official_name": "M5Stack M5PowerHub",
  "legacy_board_id": 146,
  "chip": "esp32s3",
  "pins": {
    "1": {
      "roles": [
        "conn:port_c.1"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "2": {
      "roles": [
        "conn:port_c.2"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "15": {
      "roles": [
        "bus:port_a_i2c.sda",
        "conn:port_a.2"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "16": {
      "roles": [
        "bus:port_a_i2c.scl",
        "conn:port_a.1"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "45": {
      "roles": [
        "bus:internal_i2c.sda"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "48": {
      "roles": [
        "bus:internal_i2c.scl"
      ],
      "verified": {
        "roles": "generated"
      }
    }
  },
  "buses": {
    "internal_i2c": {
      "kind": "i2c",
      "signals": [
        "sda",
        "scl"
      ],
      "preferred_host": 1,
      "fixed": false,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated"
      }
    },
    "port_a_i2c": {
      "kind": "i2c",
      "signals": [
