{
  "schema_version": 1,
  "id": "m5stickcplus",
  "name": "M5StickCPlus",
  "official_name": "M5Stack StickC-Plus",
  "official_name_verified": true,
  "aliases": [
    "stickc plus",
    "m5stickc plus",
    "stickcplus",
    "stickc-plus se",
    "plus se"
  ],
  "legacy_board_id": 4,
  "chip": "esp32_d0wdq6",
  "spec": {
    "display": {
      "resolution": [
        135,
        240
      ],
      "touch": false
    },
    "storage": {
      "psram_mb": 0,
      "flash_mb": 4
    }
  },
  "pins": {
    "0": {
      "roles": [
        "dev:usb_serial.boot"
      ]
    },
    "1": {
      "roles": [
        "bus:console_uart.tx"
      ]
    },
    "3": {
      "roles": [
        "bus:console_uart.rx"
      ]
    },
    "5": {
      "roles": [
        "dev:lcd.cs"
      ]
    },
    "13": {
      "roles": [
        "bus:main_spi.sclk"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "14": {
      "roles": [
        "bus:main_spi.miso"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "15": {
      "roles": [
        "bus:main_spi.mosi"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "18": {
      "roles": [
        "dev:lcd.rst"
      ]
    },
    "21": {
      "roles": [
        "bus:internal_i2c.sda"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "22": {
      "roles": [
        "bus:internal_i2c.scl"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "23": {
      "roles": [
        "dev:lcd.dc"
      ]
    },
    "32": {
      "roles": [
        "bus:port_a_i2c.sda",
        "conn:port_a.2"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "33": {
      "roles": [
        "bus:port_a_i2c.scl",
        "conn:port_a.1"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "37": {
      "roles": [
        "dev:btn_a.in"
      ]
    },
    "39": {
      "roles": [
        "dev:btn_b.in"
      ]
    }
  },
  "buses": {
    "console_uart": {
      "kind": "uart",
      "signals": [
        "tx",
        "rx"
      ],
      "preferred_host": 0,
      "fixed": true
    },
    "main_spi": {
      "kind": "spi",
      "signals": [
        "sclk",
        "mosi",
        "miso"
      ],
      "preferred_host": "SPI2_HOST",
      "fixed": false,
      "freq": 40000000,
      "freq_read": 15000000,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated",
        "freq": "generated",
        "freq_read": "generated"
      }
    },
    "internal_i2c": {
      "kind": "i2c",
      "signals": [
        "sda",
        "scl"
      ],
      "preferred_host": 1,
      "fixed": false,
      "freq": 400000,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated",
        "freq": "generated"
      }
    },
    "port_a_i2c": {
      "kind": "i2c",
      "signals": [
        "sda",
        "scl"
      ],
      "preferred_host": 0,
      "fixed": false,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated"
      }
    }
  },
  "devices": {
    "usb_serial": {
      "kind": "usb_uart",
      "part": "ch552",
      "bus": "console_uart",
      "spec": {
        "auto_reset": true
      },
      "signals": {
        "boot": "gpio:0"
      }
    },
    "lcd": {
      "kind": "display",
      "part": "st7789v2",
      "bus": "main_spi",
      "spec": {
        "width": 135,
        "height": 240,
        "offset_x": 52,
        "offset_y": 40,
        "invert": true,
        "three_wire": true
      },
      "signals": {
        "cs": "gpio:5",
        "rst": "gpio:18",
        "dc": "gpio:23"
      },
      "verified": {
        "signals": "generated"
      }
    },
    "backlight": {
      "kind": "backlight",
      "bus": "internal_i2c",
      "i2c_addr": "0x34"
    },
    "pmic": {
      "kind": "pmic",
      "part": "axp192",
      "bus": "internal_i2c",
      "i2c_addr": "0x34",
      "pins": {
        "pwrkey": {
          "roles": [
            "dev:btn_pwr.in"
          ]
        }
      }
    },
    "btn_a": {
      "kind": "button",
      "part": "button",
      "spec": {
        "active_low": true,
        "pull": "external_up"
      },
      "signals": {
        "in": "gpio:37"
      },
      "verified": {
        "signals": "generated"
      }
    },
    "btn_b": {
      "kind": "button",
      "part": "button",
      "spec": {
        "active_low": true,
        "pull": "external_up"
      },
      "signals": {
        "in": "gpio:39"
      },
      "verified": {
        "signals": "generated"
      }
    },
    "btn_pwr": {
      "kind": "button",
      "part": "button",
      "spec": {
        "active_low": true,
        "pull": "pmic"
      },
      "signals": {
        "in": "pin:pmic.pwrkey"
      },
      "verified": {
        "signals": "generated"
      }
    }
  },
  "connectors": {
    "port_a": {
      "type": "hy2_4p",
      "standard": "port_i2c",
      "positions": {
        "1": "gpio:33",
        "2": "gpio:32",
        "3": "pwr:5v",
        "4": "pwr:gnd"
      }
    }
  }
}
