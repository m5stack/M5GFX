{
  "schema_version": 1,
  "id": "m5vameter",
  "name": "M5VAMeter",
  "official_name": "M5Stack VAMeter",
  "official_name_verified": true,
  "aliases": [
    "vameter",
    "va meter",
    "voltage and amperage meter"
  ],
  "legacy_board_id": 16,
  "chip": "esp32s3",
  "spec": {
    "display": {
      "resolution": [
        240,
        240
      ],
      "touch": false
    },
    "storage": {
      "psram_mb": 0,
      "sd": false
    },
    "links": {
      "product": "https://docs.m5stack.com/en/core/VAMeter",
      "verified": {
        "product": "datasheet",
        "schematic": "datasheet"
      },
      "schematic": "https://m5stack-doc.oss-cn-shenzhen.aliyuncs.com/518/Sch_VAMeter_V1.2.pdf"
    }
  },
  "pins": {
    "0": {
      "roles": [
        "dev:btn_b.in"
      ]
    },
    "2": {
      "roles": [
        "dev:btn_a.in"
      ]
    },
    "5": {
      "roles": [
        "bus:internal_i2c.sda"
      ],
      "note": "System I2C SDA",
      "verified": {
        "roles": "generated"
      }
    },
    "6": {
      "roles": [
        "bus:internal_i2c.scl"
      ],
      "note": "System I2C SCL",
      "verified": {
        "roles": "generated"
      }
    },
    "7": {
      "roles": [],
      "note": "Not connected"
    },
    "8": {
      "roles": [
        "bus:port_a_i2c.sda",
        "conn:port_a.2",
        "conn:ext_in.1"
      ],
      "note": "External Port A SDA",
      "verified": {
        "roles": "generated"
      }
    },
    "9": {
      "roles": [
        "bus:port_a_i2c.scl",
        "conn:port_a.1",
        "conn:ext_in.2"
      ],
      "note": "External Port A SCL",
      "verified": {
        "roles": "generated"
      }
    },
    "10": {
      "roles": [
        "conn:ext_in.3"
      ],
      "verified": {
        "roles": "datasheet"
      }
    },
    "33": {
      "roles": [
        "dev:lcd.rst"
      ]
    },
    "34": {
      "roles": [
        "dev:lcd.dc"
      ]
    },
    "35": {
      "roles": [
        "bus:main_spi.mosi"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "36": {
      "roles": [
        "bus:main_spi.sclk"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "37": {
      "roles": [
        "dev:lcd.cs"
      ]
    },
    "38": {
      "roles": [
        "dev:backlight.pwm"
      ]
    },
    "42": {
      "roles": [
        "conn:ext_out.1"
      ],
      "verified": {
        "roles": "datasheet"
      }
    }
  },
  "buses": {
    "main_spi": {
      "kind": "spi",
      "signals": [
        "sclk",
        "mosi"
      ],
      "preferred_host": "SPI3_HOST",
      "fixed": false,
      "freq": 40000000,
      "freq_read": 16000000,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated",
        "freq": "generated",
        "freq_read": "generated"
      }
    },
    "internal_i2c": {
      "kind": "i2c",
      "signals": [
        "sda",
        "scl"
      ],
      "preferred_host": 1,
      "fixed": false,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated"
      }
    },
    "port_a_i2c": {
      "kind": "i2c",
      "signals": [
        "sda",
        "scl"
      ],
      "preferred_host": 0,
      "fixed": false,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated"
      }
    }
  },
  "devices": {
    "lcd": {
      "kind": "display",
      "part": "st7789v2",
      "bus": "main_spi",
      "spec": {
        "width": 240,
        "height": 240,
        "offset_x": 0,
        "offset_y": 0,
        "rotation_offset": 0,
        "invert": true,
        "readable": true
      },
      "signals": {
        "rst": "gpio:33",
        "dc": "gpio:34",
        "cs": "gpio:37"
      },
      "verified": {
        "signals": "generated"
      }
    },
    "backlight": {
      "kind": "backlight",
      "spec": {
        "freq": 512,
        "channel": 7,
        "invert": false,
        "offset": 64
      },
      "verified": {
        "spec": "generated",
        "signals": "generated"
      },
      "signals": {
        "pwm": "gpio:38"
      }
    },
    "probe_device_0": {
      "kind": "sensor",
      "bus": "internal_i2c",
      "i2c_addr": "0x40",
      "verified": {
        "i2c_addr": "datasheet"
      }
    },
    "probe_device_1": {
      "kind": "sensor",
      "bus": "internal_i2c",
      "i2c_addr": "0x41",
      "verified": {
        "i2c_addr": "datasheet"
      }
    },
    "btn_a": {
      "kind": "button",
      "part": "button",
      "spec": {
        "active_low": true,
        "pull": "external_up"
      },
      "signals": {
        "in": "gpio:2"
      },
      "verified": {
        "signals": "generated"
      }
    },
    "btn_b": {
      "kind": "button",
      "part": "button",
      "spec": {
        "active_low": true,
        "pull": "external_up"
      },
      "signals": {
        "in": "gpio:0"
      },
      "verified": {
        "signals": "generated"
      }
    }
  },
  "connectors": {
    "port_a": {
      "type": "hy2_4p",
      "standard": "port_i2c",
      "note": "The physical Grove (white GPIO9/yellow GPIO8) is on the included VAMeter Base, not the bare host. The existing library Port A contract is retained; no additional Grove is registered on the host.",
      "positions": {
        "1": "gpio:9",
        "2": "gpio:8",
        "3": "pwr:5v",
        "4": "pwr:gnd"
      }
    },
    "ext_in": {
      "type": "logical_terminals_6",
      "positions": {
        "1": "gpio:8",
        "2": "gpio:9",
        "3": "gpio:10",
        "4": "pwr:isolated_gnd",
        "5": "pwr:measurement_in",
        "6": "pwr:measurement_in"
      },
      "note": "Bare-host J3 CON6; FGND and FBUS_IN are the isolated measurement ground/input rail, not system ground/5V. Numbering follows the official schematic; logical terminal order, physical geometry is unverified.",
      "verified": {
        "positions": "datasheet"
      }
    },
    "ext_out": {
      "type": "logical_terminals_6",
      "positions": {
        "1": "gpio:42",
        "2": "pwr:5v",
        "3": "pwr:gnd",
        "4": "pwr:isolated_gnd",
        "5": "pwr:measurement_out",
        "6": "pwr:measurement_out"
      },
      "note": "Bare-host J4 CON6; FGND and FBUS_OUT are the isolated measurement ground/output rail. GPIO42 is WAKE. Numbering follows the official schematic; logical terminal order, physical geometry is unverified.",
      "verified": {
        "positions": "datasheet"
      }
    }
  }
}
