{
  "schema_version": 1,
  "id": "m5station",
  "name": "M5Station",
  "official_name": "M5Stack Station (Bat/485)",
  "aliases": [
    "station",
    "station-bat",
    "station-485",
    "rs485"
  ],
  "legacy_board_id": 9,
  "chip": "esp32_d0wdq6",
  "pins": {
    "0": {
      "roles": [
        "dev:usb_serial.boot"
      ]
    },
    "1": {
      "roles": [
        "bus:console_uart.tx"
      ]
    },
    "3": {
      "roles": [
        "bus:console_uart.rx"
      ]
    },
    "4": {
      "roles": [
        "dev:rgb_led.data"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "5": {
      "roles": [
        "dev:lcd.cs"
      ]
    },
    "13": {
      "roles": [
        "conn:port_c.1"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "14": {
      "roles": [
        "conn:port_c.2"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "15": {
      "roles": [
        "dev:lcd.rst"
      ]
    },
    "16": {
      "roles": [
        "conn:port_c2.1"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "17": {
      "roles": [
        "conn:port_c2.2"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "18": {
      "roles": [
        "bus:main_spi.sclk"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "19": {
      "roles": [
        "dev:lcd.dc"
      ]
    },
    "21": {
      "roles": [
        "bus:internal_i2c.sda"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "22": {
      "roles": [
        "bus:internal_i2c.scl"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "23": {
      "roles": [
        "bus:main_spi.mosi"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "25": {
      "roles": [
        "conn:port_b.2"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "26": {
      "roles": [
        "conn:port_b2.2"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "32": {
      "roles": [
        "bus:port_a_i2c.sda",
        "conn:port_a.2"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "33": {
      "roles": [
        "bus:port_a_i2c.scl",
        "conn:port_a.1"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "35": {
      "roles": [
        "conn:port_b.1"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "36": {
      "roles": [
        "conn:port_b2.1"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "37": {
      "roles": [
        "dev:btn_a.in"
      ]
    },
    "38": {
      "roles": [
        "dev:btn_b.in"
      ]
    },
    "39": {
      "roles": [
        "dev:btn_c.in"
      ]
    }
  },
  "buses": {
    "console_uart": {
      "kind": "uart",
      "signals": [
        "tx",
        "rx"
      ],
      "preferred_host": 0,
      "fixed": true
    },
    "main_spi": {
      "kind": "spi",
      "signals": [
        "sclk",
        "mosi"
      ],
      "preferred_host": "SPI2_HOST",
      "fixed": false,
      "freq": 40000000,
      "freq_read": 15000000,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated",
        "freq": "generated",
        "freq_read": "generated"
      }
    },
    "internal_i2c": {
      "kind": "i2c",
      "signals": [
        "sda",
        "scl"
      ],
      "preferred_host": 1,
      "fixed": false,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated"
      }
    },
    "port_a_i2c": {
      "kind": "i2c",
      "signals": [
        "sda",
        "scl"
      ],
      "preferred_host": 0,
      "fixed": false,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated"
      }
    }
  },
  "devices": {
    "usb_serial": {
      "kind": "usb_uart",
      "part": "ch9102f",
      "bus": "console_uart",
      "spec": {
        "auto_reset": true
      },
      "signals": {
        "boot": "gpio:0"
      }
    },
    "lcd": {
      "kind": "display",
      "part": "st7789v2",
      "bus": "main_spi",
      "spec": {
        "width": 135,
        "height": 240,
        "rotation_offset": 1
      },
      "signals": {
        "cs": "gpio:5",
        "rst": "gpio:15",
        "dc": "gpio:19"
      },
      "verified": {
        "signals": "generated"
      }
    },
    "rgb_led": {
      "kind": "led_strip",
      "signals": {
        "data": "gpio:4"
      },
      "verified": {
        "signals": "generated"
      }
    },
    "btn_a": {
      "kind": "button",
      "part": "button",
      "spec": {
        "active_low": true,
        "pull": "external_up"
      },
      "signals": {
        "in": "gpio:37"
      },
      "verified": {
        "signals": "generated"
      }
    },
    "btn_b": {
      "kind": "button",
      "part": "button",
      "spec": {
        "active_low": true,
        "pull": "external_up"
      },
      "signals": {
        "in": "gpio:38"
      },
      "verified": {
        "signals": "generated"
      }
    },
    "btn_c": {
      "kind": "button",
      "part": "button",
      "spec": {
        "active_low": true,
        "pull": "external_up"
      },
      "signals": {
        "in": "gpio:39"
      },
      "verified": {
        "signals": "generated"
      }
    }
  },
  "connectors": {
    "port_a": {
      "type": "hy2_4p",
      "standard": "port_i2c",
      "positions": {
        "1": "gpio:33",
        "2": "gpio:32",
        "3": "pwr:5v",
        "4": "pwr:gnd"
      }
    },
    "port_b": {
      "type": "hy2_4p",
      "standard": "port_io",
      "positions": {
        "1": "gpio:35",
        "2": "gpio:25",
        "3": "pwr:5v",
        "4": "pwr:gnd"
      }
    },
    "port_c": {
      "type": "hy2_4p",
      "standard": "port_uart",
      "positions": {
        "1": "gpio:13",
        "2": "gpio:14",
        "3": "pwr:5v",
        "4": "pwr:gnd"
      }
    },
    "port_b2": {
      "type": "hy2_4p",
      "standard": "port_io",
      "positions": {
        "1": "gpio:36",
        "2": "gpio:26",
        "3": "pwr:5v",
        "4": "pwr:gnd"
      }
    },
    "port_c2": {
      "type": "hy2_4p",
      "standard": "port_uart",
      "positions": {
        "1": "gpio:16",
        "2": "gpio:17",
        "3": "pwr:5v",
        "4": "pwr:gnd"
      }
    }
  }
}
