{
  "schema_version": 1,
  "id": "m5atoms3r",
  "name": "M5AtomS3R",
  "legacy_board_id": 18,
  "chip": "esp32s3",
  "spec": {
    "display": {
      "resolution": [
        128,
        128
      ],
      "touch": false
    },
    "storage": {
      "psram_mb": 8,
      "psram_mode": "opi"
    }
  },
  "pins": {
    "0": {
      "roles": [
        "bus:internal_i2c.scl"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "1": {
      "roles": [
        "bus:port_a_i2c.scl",
        "conn:port_a.1"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "2": {
      "roles": [
        "bus:port_a_i2c.sda",
        "conn:port_a.2"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "14": {
      "roles": [
        "dev:lcd.cs"
      ]
    },
    "15": {
      "roles": [
        "bus:main_spi.sclk"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "21": {
      "roles": [
        "bus:main_spi.mosi"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "41": {
      "roles": [],
      "note": "BtnA, active low"
    },
    "42": {
      "roles": [
        "dev:lcd.dc"
      ]
    },
    "45": {
      "roles": [
        "bus:internal_i2c.sda"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "48": {
      "roles": [
        "dev:lcd.rst"
      ]
    }
  },
  "buses": {
    "main_spi": {
      "kind": "spi",
      "signals": [
        "sclk",
        "mosi"
      ],
      "preferred_host": "SPI3_HOST",
      "fixed": false,
      "freq": 40000000,
      "freq_read": 16000000,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated",
        "freq": "generated",
        "freq_read": "generated"
      }
    },
    "internal_i2c": {
      "kind": "i2c",
      "signals": [
        "sda",
        "scl"
      ],
      "preferred_host": 1,
      "freq": 400000,
      "fixed": false,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated",
        "freq": "generated"
      }
    },
    "port_a_i2c": {
      "kind": "i2c",
      "signals": [
        "sda",
        "scl"
      ],
      "preferred_host": 0,
      "fixed": false,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated"
      }
    }
  },
  "devices": {
    "lcd": {
      "kind": "display",
      "bus": "main_spi",
      "part": "st7735s",
      "spec": {
        "width": 128,
        "height": 128,
        "memory_height": 132,
        "offset_x": 2,
        "offset_y": 1,
        "rotation_offset": 2,
        "invert": true,
        "readable": true,
        "panel_type": "st7735s"
      },
      "signals": {
        "cs": "gpio:14",
        "dc": "gpio:42",
        "rst": "gpio:48"
      },
      "verified": {
        "signals": "generated"
      }
    },
    "backlight": {
      "kind": "backlight",
      "bus": "internal_i2c",
      "i2c_addr": "0x30",
      "verified": {
        "i2c_addr": "datasheet"
      }
    }
  },
  "connectors": {
    "port_a": {
      "type": "hy2_4p",
      "standard": "port_i2c",
      "positions": {
        "1": "gpio:1",
        "2": "gpio:2",
        "3": "pwr:5v",
        "4": "pwr:gnd"
      }
    }
  }
}
