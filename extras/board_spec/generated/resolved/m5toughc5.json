{
  "schema_version": 1,
  "id": "m5toughc5",
  "name": "M5ToughC5",
  "official_name": "M5Stack ToughC5",
  "aliases": [
    "toughc5",
    "tough c5"
  ],
  "legacy_board_id": 33,
  "chip": "esp32c5",
  "spec": {
    "display": {
      "resolution": [
        320,
        240
      ],
      "touch": true
    },
    "storage": {
      "psram_mb": 8,
      "flash_mb": 8,
      "sd": true,
      "psram_mode": "quad"
    }
  },
  "pins": {
    "1": {
      "roles": [
        "conn:port_b.1"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "2": {
      "roles": [
        "bus:internal_i2c.sda",
        "bus:touch_i2c.sda",
        "bus:port_a_i2c.sda",
        "conn:port_a.2"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "3": {
      "roles": [
        "bus:internal_i2c.scl",
        "bus:touch_i2c.scl",
        "bus:port_a_i2c.scl",
        "conn:port_a.1"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "6": {
      "roles": [
        "conn:port_b.2"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "7": {
      "roles": [
        "bus:main_spi.mosi",
        "dev:sd.cmd"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "8": {
      "roles": [
        "bus:main_spi.miso",
        "dev:sd.d0"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "9": {
      "roles": [
        "bus:main_spi.sclk",
        "dev:sd.clk"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "10": {
      "roles": [
        "dev:sd.d3"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "11": {
      "roles": [
        "conn:port_c.2"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "12": {
      "roles": [
        "conn:port_c.1"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "25": {
      "roles": [
        "dev:lcd.cs"
      ]
    },
    "26": {
      "roles": [
        "dev:lcd.dc"
      ]
    }
  },
  "buses": {
    "main_spi": {
      "kind": "spi",
      "signals": [
        "sclk",
        "mosi",
        "miso"
      ],
      "preferred_host": "SPI2_HOST",
      "fixed": false,
      "freq": 40000000,
      "freq_read": 16000000,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated",
        "freq": "generated",
        "freq_read": "generated"
      }
    },
    "internal_i2c": {
      "kind": "i2c",
      "signals": [
        "sda",
        "scl"
      ],
      "preferred_host": 1,
      "freq": 100000,
      "fixed": true,
      "note": "preferred_host 1 is the LP-I2C port only when the SDK exposes supported LP-I2C APIs; otherwise the descriptor uses HP I2C port 0",
      "verified": {
        "signals": "generated",
        "preferred_host": "generated",
        "freq": "generated"
      }
    },
    "touch_i2c": {
      "kind": "i2c",
      "signals": [
        "sda",
        "scl"
      ],
      "preferred_host": 1,
      "freq": 400000,
      "fixed": true,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated",
        "freq": "generated"
      }
    },
    "port_a_i2c": {
      "kind": "i2c",
      "signals": [
        "sda",
        "scl"
      ],
      "preferred_host": 1,
      "fixed": true,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated"
      }
    }
  },
  "devices": {
    "lcd": {
      "kind": "display",
      "part": "ili9342c",
      "bus": "main_spi",
      "spec": {
        "width": 320,
        "height": 240,
        "invert": true,
        "readable": true,
        "rotation_offset": 0,
        "three_wire": true
      },
      "signals": {
        "cs": "gpio:25",
        "dc": "gpio:26"
      },
      "verified": {
        "signals": "generated"
      }
    },
    "sd": {
      "kind": "sd",
      "part": "sd_slot",
      "bus": "main_spi",
      "verified": {
        "bus": "generated",
        "signals": "generated",
        "derived": "generated"
      },
      "signals": {
        "cmd": "gpio:7",
        "d0": "gpio:8",
        "clk": "gpio:9",
        "d3": "gpio:10"
      },
      "derived": {
        "modes": [
          "spi"
        ],
        "bus": "main_spi",
        "cs": "gpio:10"
      }
    },
    "touch": {
      "kind": "touch",
      "part": "chsc6540",
      "bus": "touch_i2c",
      "i2c_addr": "0x2E",
      "spec": {
        "x_min": 0,
        "x_max": 319,
        "y_min": 0,
        "y_max": 239
      }
    },
    "pmic": {
      "kind": "pmic",
      "part": "m5pm1",
      "bus": "internal_i2c",
      "pins": {
        "pwrkey": {
          "roles": [
            "dev:btn_pwr.in"
          ]
        }
      }
    },
    "ioe": {
      "kind": "io_expander",
      "part": "m5ioe1",
      "bus": "internal_i2c"
    },
    "btn_pwr": {
      "kind": "button",
      "part": "button",
      "spec": {
        "active_low": true,
        "pull": "pmic"
      },
      "signals": {
        "in": "pin:pmic.pwrkey"
      },
      "verified": {
        "signals": "generated"
      }
    },
    "psram": {
      "kind": "psram",
      "part": "psram"
    }
  },
  "connectors": {
    "port_a": {
      "type": "hy2_4p",
      "standard": "port_i2c",
      "positions": {
        "1": "gpio:3",
        "2": "gpio:2",
        "3": "pwr:5v",
        "4": "pwr:gnd"
      }
    },
    "port_b": {
      "type": "hy2_4p",
      "standard": "port_io",
      "positions": {
        "1": "gpio:1",
        "2": "gpio:6",
        "3": "pwr:5v",
        "4": "pwr:gnd"
      }
    },
    "port_c": {
      "type": "hy2_4p",
      "standard": "port_uart",
      "positions": {
        "1": "gpio:12",
        "2": "gpio:11",
        "3": "pwr:5v",
        "4": "pwr:gnd"
      }
    }
  }
}
