{
  "schema_version": 1,
  "id": "arduino_nesso_n1",
  "name": "ArduinoNessoN1",
  "official_name": "Arduino Nesso N1",
  "official_name_verified": true,
  "aliases": [
    "nesso",
    "nesso n1",
    "n1",
    "arduinonesson1"
  ],
  "legacy_board_id": 23,
  "chip": "esp32c6",
  "spec": {
    "display": {
      "resolution": [
        135,
        240
      ],
      "touch": true
    }
  },
  "pins": {
    "3": {
      "roles": [
        "dev:touch.int"
      ]
    },
    "4": {
      "roles": [
        "conn:port_b.1",
        "conn:port_c.1"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "5": {
      "roles": [
        "conn:port_b.2",
        "conn:port_c.2"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "8": {
      "roles": [
        "bus:internal_i2c.scl",
        "bus:touch_i2c.scl",
        "bus:port_a_i2c.scl",
        "conn:port_a.1"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "10": {
      "roles": [
        "bus:internal_i2c.sda",
        "bus:touch_i2c.sda",
        "bus:port_a_i2c.sda",
        "conn:port_a.2"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "16": {
      "roles": [
        "dev:lcd.dc"
      ]
    },
    "17": {
      "roles": [
        "dev:lcd.cs"
      ]
    },
    "18": {
      "roles": [],
      "note": "Board-family signature pin tied low"
    },
    "20": {
      "roles": [
        "bus:main_spi.sclk"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "21": {
      "roles": [
        "bus:main_spi.mosi"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "22": {
      "roles": [
        "bus:main_spi.miso"
      ],
      "verified": {
        "roles": "generated"
      }
    }
  },
  "buses": {
    "main_spi": {
      "kind": "spi",
      "signals": [
        "sclk",
        "mosi",
        "miso"
      ],
      "preferred_host": "SPI2_HOST",
      "fixed": false,
      "freq": 40000000,
      "freq_read": 16000000,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated",
        "freq": "generated",
        "freq_read": "generated"
      }
    },
    "internal_i2c": {
      "kind": "i2c",
      "signals": [
        "sda",
        "scl"
      ],
      "preferred_host": 0,
      "fixed": false,
      "freq": 100000,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated",
        "freq": "generated"
      }
    },
    "touch_i2c": {
      "kind": "i2c",
      "signals": [
        "sda",
        "scl"
      ],
      "preferred_host": 0,
      "fixed": false,
      "freq": 400000,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated",
        "freq": "generated"
      }
    },
    "port_a_i2c": {
      "kind": "i2c",
      "signals": [
        "sda",
        "scl"
      ],
      "preferred_host": 0,
      "fixed": false,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated"
      }
    }
  },
  "devices": {
    "lcd": {
      "kind": "display",
      "part": "st7789v2",
      "bus": "main_spi",
      "spec": {
        "width": 135,
        "height": 240,
        "offset_x": 52,
        "offset_y": 40,
        "rotation_offset": 0,
        "invert": true,
        "readable": true,
        "three_wire": true
      },
      "signals": {
        "dc": "gpio:16",
        "cs": "gpio:17",
        "rst": "pin:pi4io2.p1"
      },
      "verified": {
        "signals": "generated"
      }
    },
    "touch": {
      "kind": "touch",
      "part": "ft5x06",
      "bus": "touch_i2c",
      "i2c_addr": "0x38",
      "spec": {
        "x_min": 0,
        "x_max": 134,
        "y_min": 0,
        "y_max": 239,
        "rotation_offset": 0
      },
      "signals": {
        "int": "gpio:3"
      },
      "verified": {
        "signals": "generated"
      }
    },
    "pi4io2": {
      "kind": "io_expander",
      "part": "pi4io",
      "bus": "internal_i2c",
      "i2c_addr": "0x44",
      "pins": {
        "p1": {
          "roles": [
            "dev:lcd.rst"
          ]
        },
        "p6": {
          "roles": [
            "dev:backlight.pwm"
          ]
        }
      },
      "note": "P1 LCD reset; P6 LCD backlight"
    },
    "pi4io1": {
      "kind": "io_expander",
      "part": "pi4io",
      "bus": "internal_i2c",
      "i2c_addr": "0x43",
      "note": "P0 BTN1; P1 BTN2",
      "pins": {
        "p0": {
          "roles": [
            "dev:btn_a.in"
          ]
        },
        "p1": {
          "roles": [
            "dev:btn_b.in"
          ]
        }
      }
    },
    "backlight": {
      "kind": "backlight",
      "bus": "internal_i2c",
      "i2c_addr": "0x44",
      "spec": {
        "i2c_freq": 400000
      },
      "verified": {
        "spec": "generated",
        "signals": "generated"
      },
      "signals": {
        "pwm": "pin:pi4io2.p6"
      }
    },
    "btn_a": {
      "kind": "button",
      "part": "button",
      "spec": {
        "active_low": true,
        "pull": "internal_up"
      },
      "signals": {
        "in": "pin:pi4io1.p0"
      },
      "verified": {
        "signals": "generated"
      }
    },
    "btn_b": {
      "kind": "button",
      "part": "button",
      "spec": {
        "active_low": true,
        "pull": "internal_up"
      },
      "signals": {
        "in": "pin:pi4io1.p1"
      },
      "verified": {
        "signals": "generated"
      }
    }
  },
  "connectors": {
    "port_a": {
      "type": "hy2_4p",
      "standard": "port_i2c",
      "positions": {
        "1": "gpio:8",
        "2": "gpio:10",
        "3": "pwr:5v",
        "4": "pwr:gnd"
      }
    },
    "port_b": {
      "type": "hy2_4p",
      "standard": "port_io",
      "positions": {
        "1": "gpio:4",
        "2": "gpio:5",
        "3": "pwr:5v",
        "4": "pwr:gnd"
      }
    },
    "port_c": {
      "type": "hy2_4p",
      "standard": "port_uart",
      "positions": {
        "1": "gpio:4",
        "2": "gpio:5",
        "3": "pwr:5v",
        "4": "pwr:gnd"
      }
    }
  }
}
