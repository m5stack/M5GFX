{
  "schema_version": 1,
  "id": "m5stamplc",
  "name": "M5StamPLC",
  "legacy_board_id": 21,
  "chip": "esp32s3",
  "spec": {
    "display": {
      "resolution": [
        135,
        240
      ],
      "touch": false
    },
    "storage": {
      "psram_mb": 0,
      "sd": true
    }
  },
  "pins": {
    "1": {
      "roles": [
        "bus:port_a_i2c.scl",
        "conn:port_a.1"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "2": {
      "roles": [
        "bus:port_a_i2c.sda",
        "conn:port_a.2"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "3": {
      "roles": [
        "dev:lcd.rst"
      ]
    },
    "6": {
      "roles": [
        "dev:lcd.dc"
      ]
    },
    "7": {
      "roles": [
        "bus:main_spi.sclk",
        "dev:sd.clk"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "8": {
      "roles": [
        "bus:main_spi.mosi",
        "dev:sd.cmd"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "9": {
      "roles": [
        "bus:main_spi.miso",
        "dev:sd.d0"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "10": {
      "roles": [
        "dev:sd.d3"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "12": {
      "roles": [
        "dev:lcd.cs"
      ]
    },
    "13": {
      "roles": [
        "bus:internal_i2c.sda"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "15": {
      "roles": [
        "bus:internal_i2c.scl"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "21": {
      "roles": [
        "dev:led.data"
      ],
      "verified": {
        "roles": "generated"
      }
    },
    "44": {
      "roles": [
        "dev:buzzer.data_out"
      ],
      "note": "Internal buzzer; buttons and RS485 control are provided through the IO expander"
    }
  },
  "buses": {
    "main_spi": {
      "kind": "spi",
      "signals": [
        "sclk",
        "mosi",
        "miso"
      ],
      "preferred_host": "SPI2_HOST",
      "fixed": false,
      "freq": 40000000,
      "freq_read": 16000000,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated",
        "freq": "generated",
        "freq_read": "generated"
      }
    },
    "internal_i2c": {
      "kind": "i2c",
      "signals": [
        "sda",
        "scl"
      ],
      "preferred_host": 1,
      "freq": 400000,
      "fixed": false,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated",
        "freq": "generated"
      }
    },
    "port_a_i2c": {
      "kind": "i2c",
      "signals": [
        "sda",
        "scl"
      ],
      "preferred_host": 0,
      "fixed": false,
      "verified": {
        "signals": "generated",
        "preferred_host": "generated"
      }
    }
  },
  "devices": {
    "lcd": {
      "kind": "display",
      "part": "st7789v2",
      "bus": "main_spi",
      "spec": {
        "width": 135,
        "height": 240,
        "offset_x": 52,
        "offset_y": 40,
        "rotation_offset": 1,
        "invert": true,
        "readable": true,
        "three_wire": true
      },
      "signals": {
        "rst": "gpio:3",
        "dc": "gpio:6",
        "cs": "gpio:12"
      },
      "verified": {
        "signals": "generated"
      }
    },
    "backlight": {
      "kind": "backlight",
      "bus": "internal_i2c",
      "i2c_addr": "0x43",
      "verified": {
        "i2c_addr": "datasheet"
      }
    },
    "sd": {
      "kind": "sd",
      "part": "sd_slot",
      "bus": "main_spi",
      "verified": {
        "bus": "generated",
        "signals": "generated",
        "derived": "generated"
      },
      "signals": {
        "clk": "gpio:7",
        "cmd": "gpio:8",
        "d0": "gpio:9",
        "d3": "gpio:10"
      },
      "derived": {
        "modes": [
          "spi",
          "sdio1"
        ],
        "bus": "main_spi",
        "cs": "gpio:10"
      }
    },
    "led": {
      "kind": "led_strip",
      "part": "sk6812",
      "verified": {
        "part": "datasheet",
        "signals": "generated"
      },
      "signals": {
        "data": "gpio:21"
      }
    },
    "buzzer": {
      "kind": "speaker",
      "signals": {
        "data_out": "gpio:44"
      }
    }
  },
  "connectors": {
    "port_a": {
      "type": "hy2_4p",
      "standard": "port_i2c",
      "positions": {
        "1": "gpio:1",
        "2": "gpio:2",
        "3": "pwr:5v",
        "4": "pwr:gnd"
      }
    }
  }
}
